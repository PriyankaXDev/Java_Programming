import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter n: ");
        int n = sc.nextInt();

        if (n < 0) {
            System.out.println("Invalid input");
        } else {
            int steps = 0;

            while (n > 0) {
                if (n % 2 == 0) {
                    n = n / 2;
                } else {
                    n = n - 1;
                }

                steps++;
            }

            System.out.println("Number of steps = " + steps);
        }

        sc.close();
    }
}
